{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!src/shared/ui",
      // Biome's CSS parser does not read Tailwind v4's at-rules.
      "!**/*.css",
      "!package-lock.json",
      "!tests/replay/*.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        // Radix renders both as a button, and without the names the rule sees
        // a label with nothing in it.
        "noLabelWithoutControl": {
          "level": "error",
          "options": { "inputComponents": ["RadioGroupItem", "Switch"] }
        }
      },
      "correctness": {
        // The React compiler is on and this rule does not know it.
        "useExhaustiveDependencies": "off"
      },
      "style": {
        // noUncheckedIndexedAccess is on, so each ! is the answer to it.
        "noNonNullAssertion": "off"
      }
    }
  },
  "overrides": [
    {
      // The icons carry aria-hidden through a spread, which the rule cannot read.
      "includes": ["**/ToolIcon.tsx"],
      "linter": { "rules": { "a11y": { "noSvgWithoutTitle": "off" } } }
    },
    {
      // The grip is the WAI-ARIA window splitter; the hr the rule offers can
      // neither take focus nor carry a value.
      "includes": ["**/SidebarGrip.tsx"],
      "linter": { "rules": { "a11y": { "useSemanticElements": "off" } } }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        // Imports are grouped by origin, which Biome's own sort would undo.
        "organizeImports": "off"
      }
    }
  }
}
