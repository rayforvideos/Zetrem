{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/*.mjs",
    "*.config.{ts,js}",
    "electron-builder.config.cjs",
    "**/*.test.{ts,tsx}"
  ],
  "project": [
    "src/**/*.{ts,tsx,css}",
    "electron/**/*.ts",
    "scripts/**/*.mjs"
  ],
  "ignore": [
    "src/shared/ui/**"
  ],
  "ignoreDependencies": [
    "shadcn",
    "babel-plugin-react-compiler"
  ]
}
