<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!--
      The one thing Electron needs from the hardened runtime: V8 writes machine
      code at run time, and this lets it do so through MAP_JIT and nothing wider.
      Nothing else is asked for. The app loads no native module and no dylib
      signed by anybody else, sets no DYLD variable, and talks to no other app
      by Apple Events; the CLI it runs is a separate process, not a library.
    -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
