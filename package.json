{
  "name": "zetrem",
  "productName": "Zetrem",
  "description": "A desktop app for running a team of Claude Code agents",
  "author": "Sangjun Park",
  "license": "MIT",
  "version": "1.0.0-beta.8",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "predev": "node scripts/name-dev-app.mjs",
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "fsd": "steiger ./src",
    "deadcode": "knip",
    "peek": "node --experimental-websocket scripts/peek.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "package": "electron-vite build && electron-builder --config electron-builder.config.cjs",
    "package:mac": "electron-vite build && electron-builder --mac --config electron-builder.config.cjs",
    "package:win": "electron-vite build && electron-builder --win --config electron-builder.config.cjs",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile",
    "smoke": "node --experimental-websocket scripts/smoke.mjs"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.8",
    "@biomejs/biome": "2.5.10",
    "@feature-sliced/steiger-plugin": "0.7.0",
    "@lingui/babel-plugin-lingui-macro": "^5.9.5",
    "@lingui/cli": "^6.6.0",
    "@lingui/vite-plugin": "^5.9.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "babel-plugin-macros": "^3.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "knip": "6.32.2",
    "shadcn": "^4.18.0",
    "steiger": "0.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@lingui/core": "^5.9.5",
    "@lingui/react": "^5.9.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.31.0",
    "prism-react-renderer": "^2.4.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rayforvideos/Zetrem.git"
  },
  "homepage": "https://github.com/rayforvideos/Zetrem",
  "bugs": {
    "url": "https://github.com/rayforvideos/Zetrem/issues"
  }
}
